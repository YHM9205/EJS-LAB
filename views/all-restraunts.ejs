<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Resturaunts</title>
</head>

<body>
    <h1>All Resturaunts</h1 
           <ul>
    <% restraunts.forEach(restraunt => { %>
        <li>
            <a href="/restraunts/<%= restraunt.id %> <%= restraunt.name %>"></a>
        </li>
        <% }) %>
            </ul>
</body>

</html>